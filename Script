local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
local station = script.Parent
 
local rollPart = station:WaitForChild("Roll")
local buyPart = station:WaitForChild("Buy")
local skipPart = station:WaitForChild("Skip")
local display = station:WaitForChild("BlockDisplay")
 
local collection = ReplicatedStorage:WaitForChild("Collection")
 
--------------------------------------------------
-- SETTINGS
--------------------------------------------------
 
local CLICK_DISTANCE = 25
 
local ROLL_STEPS = 36
 
local START_SPEED = 0.045
local END_SPEED = 0.16
 
--------------------------------------------------
-- RARITIES
--------------------------------------------------
 
local RARITIES = {
{Name = "Common", Chance = 50},
{Name = "Uncommon", Chance = 25},
{Name = "Rare", Chance = 12},
{Name = "Epic", Chance = 6},
{Name = "Legendary", Chance = 3},
{Name = "Mythical", Chance = 2},
{Name = "Secret", Chance = 1.5},
{Name = "Divine", Chance = 0.5},
}
 
