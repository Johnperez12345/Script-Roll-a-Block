--------------------------------------------------
-- ROLL
--------------------------------------------------
 
local function doRoll()
    
    if rolling or busy then
        return
    end
    
    rolling = true
    busy = true
    
    currentTool = nil
    currentRarity = nil
    
    clearDisplay()
    
    task.spawn(function()
        pressButton(rollPart)
    end)
    
    playSound(
    TAP_SOUND_ID,
    0.35,
    1,
    false
    )
    
    task.wait(0.06)
    
    playSound(
    WHOOSH_SOUND_ID,
    0.25,
    1,
    false
    )
    
    --------------------------------------------------
    -- FINAL RESULT
    --------------------------------------------------
    
    local finalTool,
    finalRarity =
    chooseFinalTool()
    
    if not finalTool then
        
        warn(
        "[RollSystem] Walang Tool sa Collection!"
        )
        
        rolling = false
        busy = false
        
        return
    end
    
    --------------------------------------------------
    -- GET ALL TOOLS
    --------------------------------------------------
    
    local allTools =
    getAllTools()
    
    if #allTools == 0 then
        
        warn(
        "[RollSystem] Walang Tools!"
        )
        
        rolling = false
        busy = false
        
        return
    end
    
    --------------------------------------------------
    -- ROLL SOUND
    --------------------------------------------------
    
    local rollSound =
    playSound(
    ROLL_SOUND_ID,
    0.16,
    1,
    true
    )
    
    --------------------------------------------------
    -- BUILD SEQUENCE
    --------------------------------------------------
    
    local sequence = {}
    
    local normalSteps =
    ROLL_STEPS - 8
    
    for i = 1, normalSteps do
        
        local index =
        ((i - 1)
        % #allTools)
        + 1
        
        table.insert(
        sequence,
        allTools[index]
        )
        
    end
    
    --------------------------------------------------
    -- FINAL 8
    --------------------------------------------------
    
    for i = 1, 8 do
        
        table.insert(
        sequence,
        finalTool
        )
        
    end
    
    --------------------------------------------------
    -- ROLL ANIMATION
    --------------------------------------------------
    
    for i, tool in ipairs(sequence) do
        
        showNextBlock(tool)
        
        local progress =
        (i - 1)
        / math.max(
        1,
        #sequence - 1
        )
        
        local delayTime =
        START_SPEED
        + (
        END_SPEED
        - START_SPEED
        )
        * (progress ^ 2)
        
        task.wait(delayTime)
    end
    
    --------------------------------------------------
    -- STOP ROLL SOUND
    --------------------------------------------------
    
    if rollSound then
        rollSound:Stop()
        rollSound:Destroy()
    end
    
    --------------------------------------------------
    -- FINAL DISPLAY
    --------------------------------------------------
    
    local finalDisplay =
    showTool(finalTool)
    
    finalBounce(finalDisplay)
    
    --------------------------------------------------
    -- BILLBOARD
    --------------------------------------------------
    
    addFinalBillboard(
    finalTool,
    finalDisplay
    )
    
    --------------------------------------------------
    -- SAVE RESULT
    --------------------------------------------------
    
    currentTool = finalTool
    currentRarity = finalRarity
    
    rolling = false
    busy = false
end
 
--------------------------------------------------
-- BUY
--------------------------------------------------
 
local function doBuy(player)
    
    if rolling or busy then
        return
    end
    
    if not currentTool then
        return
    end
    
    busy = true
    
    --------------------------------------------------
    -- BUTTON
    --------------------------------------------------
    
    task.spawn(function()
        pressButton(buyPart)
    end)
    
    playSound(
    TAP_SOUND_ID,
    0.35,
    1,
    false
    )
    
    --------------------------------------------------
    -- FIND LEADERSTATS
    --------------------------------------------------
    
    local leaderstats =
    player:FindFirstChild("leaderstats")
    
    if not leaderstats then
        
        warn("leaderstats not found!")
        
        busy = false
        
        return
    end
    
    --------------------------------------------------
    -- FIND MONEY
    --------------------------------------------------
    
    local money =
    leaderstats:FindFirstChild("Money")
    
    if not money then
        
        warn("Money not found!")
        
        busy = false
        
        return
    end
    
    --------------------------------------------------
    -- FIND PRICE
    --------------------------------------------------
    
    local price =
    currentTool:FindFirstChild("Price")
    
    if not price then
        
        warn(
        "Price not found inside "
        .. currentTool.Name
        )
        
        showNotification(
        player,
        "Price not found!"
        )
        
        busy = false
        
        return
    end
    
    --------------------------------------------------
    -- CHECK PRICE TYPE
    --------------------------------------------------
    
    if not price:IsA("IntValue")
        and not price:IsA("NumberValue") then
        
        warn(
        "Price must be IntValue or NumberValue!"
        )
        
        showNotification(
        player,
        "Invalid block price!"
        )
        
        busy = false
        
        return
    end
    
    local priceAmount =
    price.Value
    
    --------------------------------------------------
    -- NOT ENOUGH CASH
    --------------------------------------------------
    
    if money.Value < priceAmount then
        
        showNotification(
        player,
        "Not enough cash"
        )
        
        busy = false
        
        return
    end
    
    --------------------------------------------------
    -- REMOVE MONEY
    --------------------------------------------------
    
    money.Value =
    money.Value - priceAmount
    
    --------------------------------------------------
    -- CLONE TOOL
    --------------------------------------------------
    
    local toolToGive =
    currentTool:Clone()
    
    local object =
    displayedObject
    
    --------------------------------------------------
    -- FLY TO PLAYER
    --------------------------------------------------
    
    if object
        and object.Parent then
        
        local character =
        player.Character
        
        local root =
        character
        and character:FindFirstChild(
        "HumanoidRootPart"
        )
        
        if root then
            
            local targetCFrame =
            root.CFrame
            * CFrame.new(
            0,
            1.5,
            -2
            )
            
            local flyTween =
            TweenService:Create(
            object,
            TweenInfo.new(
            0.35,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.In
            ),
            {
            CFrame =
            targetCFrame
            * CFrame.Angles(
            0,
            math.rad(360),
            0
            )
            }
            )
            
            flyTween:Play()
            flyTween.Completed:Wait()
            
        end
    end
    
    --------------------------------------------------
    -- GIVE TOOL
    --------------------------------------------------
    
    local backpack =
    player:FindFirstChildOfClass(
    "Backpack"
    )
    
    if backpack then
        
        toolToGive.Parent =
        backpack
        
    else
        
        toolToGive:Destroy()
        
    end
    
    --------------------------------------------------
    -- SUCCESS MESSAGE
    --------------------------------------------------
    
    showNotification(
    player,
    "You successfully bought a block!"
    )
    
    --------------------------------------------------
    -- CLEAR DISPLAY
    --------------------------------------------------
    
    clearDisplay()
    
    currentTool = nil
    currentRarity = nil
    
    busy = false
end
 
--------------------------------------------------
-- SKIP
--------------------------------------------------
 
local function doSkip()
    
    if rolling or busy then
        return
    end
    
    if not currentTool then
        return
    end
    
    busy = true
    
    task.spawn(function()
        pressButton(skipPart)
    end)
    
    playSound(
    TAP_SOUND_ID,
    0.35,
    1,
    false
    )
    
    local object =
    displayedObject
    
    if object
        and object.Parent then
        
        local disappearTween =
        TweenService:Create(
        object,
        TweenInfo.new(
        0.3,
        Enum.EasingStyle.Back,
        Enum.EasingDirection.In
        ),
        {
        CFrame =
        object.CFrame
        * CFrame.new(
        0,
        1.5,
        0
        )
        * CFrame.Angles(
        math.rad(180),
        math.rad(180),
        0
        ),
        
        Transparency = 1
        }
        )
        
        disappearTween:Play()
        disappearTween.Completed:Wait()
        
    end
    
    clearDisplay()
    
    currentTool = nil
    currentRarity = nil
    
    busy = false
end
 
