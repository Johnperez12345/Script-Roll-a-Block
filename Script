-- SOUNDS
--------------------------------------------------
 
local TAP_SOUND_ID = "rbxassetid://113397864512278"
local WHOOSH_SOUND_ID = "rbxassetid://137081214744553"
local ROLL_SOUND_ID = "rbxassetid://70482547486758"
 
--------------------------------------------------
-- VARIABLES
--------------------------------------------------
 
local currentTool = nil
local currentRarity = nil
 
local rolling = false
local busy = false
 
local displayedObject = nil
 
--------------------------------------------------
-- CLICK DETECTORS
--------------------------------------------------
 
local function getClickDetector(part)
    
    local detector = part:FindFirstChildOfClass("ClickDetector")
    
    if not detector then
        detector = Instance.new("ClickDetector")
        detector.Parent = part
    end
    
    detector.MaxActivationDistance = CLICK_DISTANCE
    
    return detector
end
 
local rollClick = getClickDetector(rollPart)
local buyClick = getClickDetector(buyPart)
local skipClick = getClickDetector(skipPart)
 
--------------------------------------------------
-- SOUND
--------------------------------------------------
 
local function playSound(
    soundId,
    volume,
    playbackSpeed,
    looped
    )
    
    local sound = Instance.new("Sound")
    
    sound.SoundId = soundId
    sound.Volume = volume or 0.5
    sound.PlaybackSpeed = playbackSpeed or 1
    sound.Looped = looped or false
    
    sound.Parent = station
    sound:Play()
    
    if not looped then
        Debris:AddItem(sound, 5)
    end
    
    return sound
end
 
--------------------------------------------------
-- BUTTON ANIMATION
--------------------------------------------------
 
local function pressButton(part)
    
    local originalSize = part.Size
    local smallerSize = originalSize * 0.92
    
    local downTween = TweenService:Create(
    part,
    TweenInfo.new(
    0.06,
    Enum.EasingStyle.Quad,
    Enum.EasingDirection.Out
    ),
    {
    Size = smallerSize
    }
    )
    
    local upTween = TweenService:Create(
    part,
    TweenInfo.new(
    0.09,
    Enum.EasingStyle.Back,
    Enum.EasingDirection.Out
    ),
    {
    Size = originalSize
    }
    )
    
    downTween:Play()
    downTween.Completed:Wait()
    
    upTween:Play()
end
 
--------------------------------------------------
-- GET ALL TOOLS
--------------------------------------------------
 
local function getAllTools()
    
    local tools = {}
    
    for _, rarityData in ipairs(RARITIES) do
        
        local rarityFolder =
        collection:FindFirstChild(rarityData.Name)
        
        if rarityFolder then
            
            for _, item in ipairs(rarityFolder:GetChildren()) do
                
                if item:IsA("Tool") then
                    table.insert(tools, item)
                end
                
            end
            
        end
        
    end
    
    return tools
end
 
--------------------------------------------------
-- CHOOSE RARITY
--------------------------------------------------
 
local function chooseRarity()
    
    local randomNumber = math.random() * 100
    
    local total = 0
    
    for _, rarityData in ipairs(RARITIES) do
        
        total += rarityData.Chance
        
        if randomNumber <= total then
            return rarityData.Name
        end
        
    end
    
    return "Common"
end
 
--------------------------------------------------
-- GET TOOLS FROM RARITY
--------------------------------------------------
 
local function getToolsFromRarity(rarityName)
    
    local result = {}
    
    local folder =
    collection:FindFirstChild(rarityName)
    
    if not folder then
        return result
    end
    
    for _, item in ipairs(folder:GetChildren()) do
        
        if item:IsA("Tool") then
            table.insert(result, item)
        end
        
    end
    
    return result
end
 
--------------------------------------------------
-- CHOOSE FINAL TOOL
--------------------------------------------------
 
local function chooseFinalTool()
    
    local rarity = chooseRarity()
    
    local rarityTools =
    getToolsFromRarity(rarity)
    
    if #rarityTools == 0 then
        
        local allTools =
        getAllTools()
        
        if #allTools == 0 then
            return nil, nil
        end
        
        local randomTool =
        allTools[
        math.random(
        1,
        #allTools
        )
        ]
        
        return randomTool, rarity
    end
    
    local selectedTool =
    rarityTools[
    math.random(
    1,
    #rarityTools
    )
    ]
    
    return selectedTool, rarity
end
 
--------------------------------------------------
-- CLEAR DISPLAY
--------------------------------------------------
 
local function clearDisplay()
    
    if displayedObject then
        displayedObject:Destroy()
        displayedObject = nil
    end
    
    for _, child in ipairs(display:GetChildren()) do
        
        if child:IsA("BasePart")
            or child:IsA("Model")
            or child:IsA("Tool") then
            
            child:Destroy()
            
        end
        
    end
end
 
--------------------------------------------------
-- FIND HANDLE
--------------------------------------------------
 
local function findHandle(tool)
    
    local handle =
    tool:FindFirstChild("Handle")
    
    if handle
        and handle:IsA("BasePart") then
        
        return handle
    end
    
    for _, object in ipairs(tool:GetDescendants()) do
        
        if object:IsA("BasePart") then
            return object
        end
        
    end
    
    return nil
end
 
--------------------------------------------------
-- SHOW TOOL
--------------------------------------------------
 
local function showTool(tool)
    
    if not tool then
        return nil
    end
    
    clearDisplay()
    
    local handle =
    findHandle(tool)
    
    if not handle then
        
        warn(
        "[RollSystem] Handle not found: "
        .. tool.Name
        )
        
        return nil
    end
    
    --------------------------------------------------
    -- EXACT HANDLE CLONE
    --------------------------------------------------
    
    local clone =
    handle:Clone()
    
    --------------------------------------------------
    -- REMOVE BILLBOARD DURING ROLL
    --------------------------------------------------
    
    for _, object in ipairs(clone:GetDescendants()) do
        
        if object:IsA("BillboardGui") then
            object:Destroy()
        end
        
    end
    
    --------------------------------------------------
    -- PHYSICS
    --------------------------------------------------
    
    clone.Anchored = true
    clone.CanCollide = false
    clone.CanTouch = false
    clone.CanQuery = false
    
    --------------------------------------------------
    -- NO SIZE CHANGE
    --------------------------------------------------
    
    clone.CFrame =
    CFrame.new(
    display.Position
    + Vector3.new(
    0,
    2.5,
    0
    )
    )
    
    clone.Parent = display
    
    displayedObject = clone
    
    return clone
end
 
--------------------------------------------------
-- SHOW NEXT BLOCK
--------------------------------------------------
 
local function showNextBlock(tool)
    
    if not tool then
        return
    end
    
    local object =
    showTool(tool)
    
    if not object then
        return
    end
    
    local startCFrame =
    object.CFrame
    
    local moveTween =
    TweenService:Create(
    object,
    TweenInfo.new(
    0.07,
    Enum.EasingStyle.Quad,
    Enum.EasingDirection.Out
    ),
    {
    CFrame =
    startCFrame
    * CFrame.new(
    0,
    0.15,
    0
    )
    * CFrame.Angles(
    0,
    math.rad(12),
    0
    )
    }
    )
    
    moveTween:Play()
    moveTween.Completed:Wait()
    
    if object
        and object.Parent then
        
        local returnTween =
        TweenService:Create(
        object,
        TweenInfo.new(
        0.05,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.In
        ),
        {
        CFrame = startCFrame
        }
        )
        
        returnTween:Play()
    end
end
 
--------------------------------------------------
-- FINAL BILLBOARD
--------------------------------------------------
 
local function addFinalBillboard(
    tool,
    displayedHandle
    )
    
    if not tool then
        return
    end
    
    if not displayedHandle then
        return
    end
    
    local billboard =
    tool:FindFirstChild(
    "BillboardGui",
    true
    )
    
    if not billboard then
        
        warn(
        "[RollSystem] BillboardGui not found inside Tool: "
        .. tool.Name
        )
        
        return
    end
    
    --------------------------------------------------
    -- EXACT BILLBOARD COPY
    -- TEXT IS NOT CHANGED
    --------------------------------------------------
    
    local billboardClone =
    billboard:Clone()
    
    billboardClone.Enabled = true
    billboardClone.Parent = displayedHandle
end
 
--------------------------------------------------
-- FINAL BOUNCE
--------------------------------------------------
 
local function finalBounce(object)
    
    if not object then
        return
    end
    
    if not object.Parent then
        return
    end
    
    local originalCFrame =
    object.CFrame
    
    local upTween =
    TweenService:Create(
    object,
    TweenInfo.new(
    0.18,
    Enum.EasingStyle.Back,
    Enum.EasingDirection.Out
    ),
    {
    CFrame =
    originalCFrame
    * CFrame.new(
    0,
    0.45,
    0
    )
    * CFrame.Angles(
    0,
    math.rad(360),
    0
    )
    }
    )
    
    upTween:Play()
    upTween.Completed:Wait()
    
    if not object.Parent then
        return
    end
    
    local downTween =
    TweenService:Create(
    object,
    TweenInfo.new(
    0.14,
    Enum.EasingStyle.Bounce,
    Enum.EasingDirection.Out
    ),
    {
    CFrame = originalCFrame
    }
    )
    
    downTween:Play()
    downTween.Completed:Wait()
end
 
